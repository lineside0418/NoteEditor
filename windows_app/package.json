{
  "name": "ricf1-note-editor",
  "version": "1.0.0",
  "description": "RICF-1 Note Editor Native App",
  "main": "main.js",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "build": "electron-builder --win --x64"
  },
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.seikocomb.noteeditor",
    "productName": "NoteEditor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "../index.html",
      "../converter.html",
      "../css/**/*",
      "../js/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}